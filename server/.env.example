# 复制为 .env 后生效（server 启动时用 node --env-file-if-exists=.env 自动读取）
# 改完必须重启后端：Ctrl+C 或 Stop-Process 掉 3001 端口后 npm start

# 服务端口
PORT=3001

# 数据库文件路径（相对 server/ 目录，或写绝对路径）
DB_PATH=./data/health.db

# 单用户免登录模式下的默认用户 id（schema.sql 中已预置 id=1）
DEFAULT_USER_ID=1

# ============================================================
# 零、账号（多账号模式：每人用自己的用户名 + 密码登录，数据互不可见）
# ============================================================
# 历史数据挂在 id=1 的「主账号」上。第一次启动时如果它还没有密码，
# 就用下面的 OWNER_PASSWORD 自动设置；以后用它登录就能看到原来的数据。
OWNER_USERNAME=me
OWNER_PASSWORD=换成你自己的密码
# 别人注册要填的邀请码。留空 = 任何人都能注册（部署公网时务必设置）
REGISTER_CODE=
# Cookie 签名密钥：换掉它 = 所有设备强制重新登录。可留空，留空则按口令派生
SESSION_SECRET=


# production 时：关闭开发用的 CORS，Cookie 自动加 Secure（只在 HTTPS 下发送）
NODE_ENV=development

# 备份目录与保留份数（npm run backup 用）
# BACKUP_DIR=./backups
# BACKUP_KEEP=14

# ============================================================
# 一、文本模型（第五步 AI 问答用，现在留空也不影响拍照识别）
# ============================================================
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat

# ============================================================
# 二、视觉模型（第四步拍照识别食物）—— 这里是唯一需要你填的地方
# ============================================================
# ⚠️ DeepSeek 官方 API 目前只有文本模型（deepseek-chat），没有视觉模型，
#    所以「拍照认菜」必须接一个支持图片的 OpenAI 兼容接口。三种常见选择：
#
# ① 智谱 GLM-4V（有免费额度，中文菜识别效果好，推荐先试这个）
#    注册：https://open.bigmodel.cn  →  API Keys
# AI_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_VISION_MODEL=glm-4v-flash
#
# ② 通义千问 VL（阿里云百炼）
#    注册：https://bailian.console.aliyun.com  →  API-KEY
# AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_VISION_MODEL=qwen-vl-max
#
# ③ OpenAI
# AI_VISION_BASE_URL=https://api.openai.com/v1
# AI_VISION_MODEL=gpt-4o-mini
#
# 视觉 Key：只填一个即可。填 AI_VISION_API_KEY 就走视觉专用 Key；
# 留空则复用上面的 AI_API_KEY（当文本和视觉是同一家厂商时更省事）。
AI_VISION_API_KEY=
AI_VISION_BASE_URL=
AI_VISION_MODEL=
# 输出上限。智谱 glm-4v 系列只允许 1~1024，所以默认 1024；
# 换成 gpt-4o-mini 这类上限更高的模型可以调大到 2000 左右（菜多时 JSON 不易被截断）。
# AI_VISION_MAX_TOKENS=1024
# 识别超时（毫秒）。云端模型一般 5-10 秒足够；
# 换成本地模型（Ollama / LM Studio）跑视觉时建议调到 180000 以上。
# AI_VISION_TIMEOUT=60000

# 没有 Key 时想先体验整条链路：设 1 会返回固定的演示数据（米饭/鸡胸肉/西兰花），
# 响应里 meta.mode='fake'，页面上也会标明「演示数据」。
VISION_FAKE=0

# ---------------------------------------------------------------
# 费用护栏（2026-11 加入，分享给朋友前必须有）
# ---------------------------------------------------------------
# 供应商白名单：只有这些域名会被真正请求。默认只允许智谱开放平台，
# 防止某个残留配置把请求打到按量计费的平台上（例如 api.deepseek.com）。
# 要换厂商就把它加进来，多个用英文逗号分隔，例如：
#   AI_ALLOWED_HOSTS=open.bigmodel.cn,dashscope.aliyuncs.com
AI_ALLOWED_HOSTS=open.bigmodel.cn

# 全站每日 AI 调用总上限（拍照识别 + 对话 + 连接检测都算）。
# 超出后当天所有人都会被拒绝，第二天自动恢复。个人共享用途 300 够用。
AI_DAILY_LIMIT=300
